{
  "name": "babata-sidebar",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "description": "Local-first AI browser sidebar with page translation and Codex, Claude Code, or Grok companion support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r266-tech/babata-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/r266-tech/babata-sidebar/issues"
  },
  "homepage": "https://github.com/r266-tech/babata-sidebar#readme",
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    }
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "companion": "node companion/server.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke:companion": "node scripts/smoke-companion.mjs",
    "smoke:sidebar": "node scripts/smoke-sidebar.mjs",
    "smoke:rich-card": "node scripts/smoke-rich-card.mjs",
    "smoke:server-origin-fallback": "node scripts/smoke-server-origin-fallback.mjs",
    "smoke:translation-links": "node scripts/smoke-translation-links.mjs",
    "smoke:llm": "node scripts/smoke-llm.mjs",
    "smoke": "npm run smoke:companion && npm run smoke:sidebar && npm run smoke:rich-card"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.2",
    "marked": "^18.0.3",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.32",
    "@preact/preset-vite": "^2.10.1",
    "@types/chrome": "^0.0.287",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
